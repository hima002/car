# GEMINI_API_KEY: Google Gemini API key used by the AI diagnostics assistant
# (chat + photo-based fault diagnosis).
# Local development: copy this file to `.env` and put your real key there
# (`.env` is gitignored, never commit a real key).
# CI: the GitHub Actions workflow writes the GEMINI_API_KEY repository
# secret into `.env` at build time — this file is only the placeholder default.
GEMINI_API_KEY=
