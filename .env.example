# PLACES_API_KEY: Google Places API key used by the Workshop Finder feature
# to find nearby real car-repair workshops with real ratings.
# Local development: copy this file to `.env` and put your real key there
# (`.env` is gitignored, never commit a real key).
# CI: the GitHub Actions workflow writes the GOOGLE_PLACES_API_KEY repository
# secret into `.env` at build time — this file is only the placeholder default.
PLACES_API_KEY=

# GEMINI_API_KEY: Google Gemini API key used by the AI diagnostics assistant
# (chat + photo-based fault diagnosis). Same handling as PLACES_API_KEY above.
GEMINI_API_KEY=
